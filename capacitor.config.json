{
  "appId": "info.akfish.app",
  "appName": "akFISHinfo",
  "webDir": "public",
  "appendUserAgent": "akFISHinfo-Native",
  "backgroundColor": "#060a0fff",
  "server": {
    "androidScheme": "https",
    "iosScheme": "capacitor",
    "allowNavigation": [
      "akfishinfo.com",
      "*.akfishinfo.com"
    ]
  },
  "ios": {
    "contentInset": "automatic",
    "backgroundColor": "#060a0fff"
  },
  "android": {
    "allowMixedContent": false,
    "backgroundColor": "#060a0fff"
  },
  "plugins": {
    "CapacitorHttp": {
      "enabled": true
    }
  }
}
