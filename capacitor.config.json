{
  "appId": "info.akfish.app",
  "appName": "akFISHinfo",
  "webDir": "public",
  "appendUserAgent": "akFISHinfo-Native",
  "server": {
    "url": "https://akfishinfo.com",
    "androidScheme": "https",
    "iosScheme": "capacitor",
    "allowNavigation": [
      "akfishinfo.com",
      "*.akfishinfo.com"
    ]
  },
  "ios": {
    "contentInset": "automatic"
  },
  "android": {
    "allowMixedContent": false
  }
}
